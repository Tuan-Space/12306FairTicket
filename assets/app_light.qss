/* Light palette overrides; structural styling comes from app.qss. */
QPushButton#stepButton[stepState="current"] { background: #eaf4ff; border-color: #3b82df; color: #1769c2; }
QPushButton#stepButton[stepState="complete"] { color: #177a55; border-color: #b7d7c8; }
QPushButton#stepButton[stepState="pending"] { color: #687792; }
QLabel#workflowStatus { background: #ffffff; }
* { color: #26344d; }

QMainWindow, QWidget#appRoot, QDialog#passengerSelectionDialog, QDialog#cartDialog, QScrollArea, QScrollArea > QWidget > QWidget {
    background: #f3f6fb;
}

QLabel#appTitle { color: #17223a; }
QLabel#muted { color: #687792; }

QLabel#privacyBadge, QLabel#phaseBadge {
    border-color: #bad7fa;
    background: #eaf4ff;
    color: #1769c2;
}

QLabel#phaseBadge[phaseState="success"] { color: #14764d; border-color: #a6d5ba; background: #eef9f2; }
QLabel#phaseBadge[phaseState="unknown"] { color: #925d00; border-color: #dfc587; background: #fff8e6; }
QLabel#phaseBadge[phaseState="failed"] { color: #b82e41; border-color: #ecc0c7; background: #fff0f2; }

QFrame#profileBar, QFrame#card {
    background: #ffffff;
    border-color: #dce4f0;
}

QLabel#cardTitle { color: #17223a; }
QLabel#fieldLabel { color: #34435d; }
QLabel#saleCountdown { color: #17223a; }
QLabel#qrCountdown { color: #177a55; }

QLabel#qrImage {
    background: #ffffff;
    color: #687792;
    border-color: #ccd7e7;
}

QLabel#windowMarker {
    color: #1769c2;
    background: #eaf4ff;
}

QLabel#aisle {
    color: #8a96aa;
    border-color: #ced7e5;
}

QFrame#metric {
    background: #f7f9fd;
    border-color: #dbe3ef;
}

QLabel#metricName { color: #70809a; }
QLabel#metricValue { color: #263a5c; }

QLineEdit, QComboBox, QDateEdit, QSpinBox, QDoubleSpinBox {
    color: #26344d;
    background: #f9fbfe;
    border-color: #cbd6e6;
}

QLineEdit:hover, QComboBox:hover, QDateEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: #91a5c1;
}

QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #3b82df;
    background: #ffffff;
}

QLineEdit[validationState="error"], QComboBox[validationState="error"],
QDateEdit[validationState="error"], QSpinBox[validationState="error"],
QDoubleSpinBox[validationState="error"] {
    border: 2px solid #d84759;
    background: #fff4f5;
}

QLineEdit[validationState="warning"], QComboBox[validationState="warning"],
QDateEdit[validationState="warning"], QSpinBox[validationState="warning"],
QDoubleSpinBox[validationState="warning"] {
    border: 2px solid #b7791f;
    background: #fff9ed;
}

QWidget#timeFields[validationState="error"] {
    border: 2px solid #d84759;
    border-radius: 9px;
    background: #fff4f5;
}

QWidget#timeFields[validationState="warning"] {
    border: 2px solid #b7791f;
    border-radius: 9px;
    background: #fff9ed;
}

QWidget[validationState="error"] QLabel#validationMessage { color: #bc3044; }
QWidget[validationState="warning"] QLabel#validationMessage { color: #956114; }
QWidget#fieldBlock[validationState="error"] {
    border: 1px solid #d94257;
    border-radius: 9px;
    background: #fff2f4;
}
QWidget#fieldBlock[validationState="warning"] {
    border: 1px solid #c58a28;
    border-radius: 9px;
    background: #fff9eb;
}

QComboBox QAbstractItemView {
    color: #26344d;
    background: #ffffff;
    border-color: #cad5e5;
    selection-background-color: #d9eaff;
    selection-color: #184f8f;
}

QComboBox::down-arrow {
    image: url(assets/chevron-down-light.svg);
}

QCalendarWidget#dateCalendar QWidget#qt_calendar_navigationbar {
    background: #edf1f5;
    border: 0;
}

QCalendarWidget#dateCalendar QToolButton {
    color: #3b4a60;
    background: #f7f9fc;
    border-color: #d3dce8;
}

QCalendarWidget#dateCalendar QToolButton:hover {
    color: #263a54;
    background: #e9eef4;
    border-color: #b8c5d5;
}

QCalendarWidget#dateCalendar QAbstractItemView {
    color: #34435d;
    background: #ffffff;
    alternate-background-color: #f6f8fb;
    selection-background-color: #607991;
    selection-color: #ffffff;
}

QPushButton, QToolButton {
    color: #35445e;
    background: #f4f7fb;
    border-color: #cdd8e7;
}

QPushButton:hover, QToolButton:hover {
    color: #1b3151;
    background: #eaf1fb;
    border-color: #9cadc5;
}

QPushButton:pressed, QToolButton:pressed { background: #dfe8f5; }

QPushButton:disabled, QToolButton:disabled {
    color: #a1abb9;
    background: #f4f6f9;
    border-color: #e2e6ed;
}

QPushButton#primaryButton {
    color: #ffffff;
    background: #2d78dc;
    border-color: #2d78dc;
}

QPushButton#primaryButton:hover { background: #3d86e5; }

QPushButton#dangerButton {
    color: #b43d50;
    background: #fff0f2;
    border-color: #f1bdc5;
}

QToolButton#seatButton {
    color: #34435d;
    background: #f7f9fc;
    border-color: #cbd6e5;
}

QToolButton#seatButton:checked {
    color: #ffffff;
    background: #2875ce;
    border-color: #1765bd;
}

QCheckBox { color: #34435d; }
QCheckBox::indicator { background: #ffffff; border-color: #9aaac0; }
QCheckBox::indicator:checked { background: #2f7fdf; border-color: #2f7fdf; image: url(assets/check.svg); }

QToolButton#helpButton {
    color: #216dbd;
    background: #e9f3ff;
    border-color: #9fc5ed;
}
QCheckBox:disabled { color: #94a0b2; }

QTabBar::tab { color: #687792; }
QTabBar::tab:selected { color: #1d3352; border-bottom-color: #317fdc; }
QTabBar::tab:hover:!selected { color: #344a67; }

QListWidget#cartPriorityList {
    color: #34435d;
    background: #f8fafd;
    border-color: #d4deea;
}

QListWidget#cartPriorityList::item:selected {
    color: #194f8e;
    background: #dcecff;
}

QTextEdit#logView {
    color: #273852;
    background: #f8fafd;
    border-color: #d4deea;
    selection-background-color: #bcd8f8;
}

QScrollBar::handle:vertical { background: #b8c4d4; }
QScrollBar::handle:vertical:hover { background: #98a8bd; }

QToolTip {
    color: #26344d;
    background: #ffffff;
    border-color: #bcc9da;
}

QLineEdit > QToolButton, QLineEdit > QToolButton:hover,
QLineEdit > QToolButton:pressed, QLineEdit > QToolButton:disabled {
    background: transparent;
    border: 0;
}

QToolButton#seatGroupToggle { color: #26344d; background: transparent; }
QToolButton#seatGroupToggle:hover { background: #edf3fc; }
QCheckBox#seatChoice { background: #ffffff; border-color: #c9d6e8; }
QCheckBox#seatChoice:hover { border-color: #97b1d5; }
QCheckBox#seatChoice:checked { background: #edf5ff; border-color: #347ff0; color: #175dad; }
QCheckBox#seatChoice:focus { border-color: #347ff0; }
QCheckBox#seatChoice:disabled { color: #8793a7; }
