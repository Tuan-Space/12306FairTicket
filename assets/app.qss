/* 12306 Fair Ticket desktop theme */
* {
    font-family: "Microsoft YaHei UI", "Segoe UI", sans-serif;
    font-size: 13px;
    color: #dbe5f7;
}

QMainWindow, QWidget#appRoot, QScrollArea, QScrollArea > QWidget > QWidget {
    background: #0b1020;
}

QFrame#header {
    background: transparent;
}

QLabel#logoMark {
    min-width: 52px;
    min-height: 52px;
    border-radius: 16px;
    color: #ffffff;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #3b8cff, stop:1 #6e5dff);
    font-size: 27px;
    font-weight: 700;
    qproperty-alignment: AlignCenter;
    margin-right: 5px;
}

QLabel#appTitle {
    font-size: 24px;
    font-weight: 700;
    color: #f7f9ff;
}

QLabel#muted {
    color: #8f9bb3;
    font-size: 12px;
}

QLabel#privacyBadge, QLabel#phaseBadge {
    border: 1px solid #26456c;
    border-radius: 12px;
    background: #12243d;
    color: #7fbdff;
    padding: 6px 11px;
    font-weight: 600;
}

QFrame#profileBar, QFrame#card {
    background: #11182a;
    border: 1px solid #202b43;
    border-radius: 14px;
}

QLabel#cardTitle {
    color: #f4f7ff;
    font-size: 16px;
    font-weight: 700;
}

QLabel#fieldLabel {
    color: #c8d3e8;
    font-weight: 600;
}

QLabel#saleCountdown {
    color: #f8fbff;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 39px;
    font-weight: 700;
    padding: 8px 0;
}

QLabel#qrCountdown {
    color: #79d7b0;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 16px;
    font-weight: 600;
}

QLabel#qrImage {
    background: #f7f9ff;
    color: #536079;
    border: 1px solid #33415c;
    border-radius: 13px;
    padding: 6px;
}

QLabel#windowMarker {
    color: #79aef8;
    background: #102747;
    border-radius: 8px;
    padding: 8px 4px;
}

QLabel#aisle {
    color: #69758e;
    border-left: 1px dashed #39445d;
    border-right: 1px dashed #39445d;
    min-width: 48px;
}

QFrame#metric {
    background: #0d1425;
    border: 1px solid #202c45;
    border-radius: 10px;
}

QLabel#metricName {
    color: #7786a4;
    font-size: 11px;
}

QLabel#metricValue {
    color: #d8e6ff;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 14px;
    font-weight: 700;
}

QLineEdit, QComboBox, QDateEdit, QSpinBox, QDoubleSpinBox {
    min-height: 34px;
    background: #0c1425;
    border: 1px solid #2a3751;
    border-radius: 8px;
    padding: 2px 9px;
    selection-background-color: #337ee8;
}

QLineEdit:hover, QComboBox:hover, QDateEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: #43577b;
}

QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #438cf5;
    background: #0e192d;
}

QLineEdit[validationState="error"], QComboBox[validationState="error"],
QDateEdit[validationState="error"], QSpinBox[validationState="error"],
QDoubleSpinBox[validationState="error"] {
    border: 2px solid #ef6472;
    background: #271721;
}

QLineEdit[validationState="warning"], QComboBox[validationState="warning"],
QDateEdit[validationState="warning"], QSpinBox[validationState="warning"],
QDoubleSpinBox[validationState="warning"] {
    border: 2px solid #e6ad50;
    background: #2a2115;
}

QWidget#timeFields[validationState="error"] {
    border: 2px solid #ef6472;
    border-radius: 9px;
    background: #271721;
}

QWidget#timeFields[validationState="warning"] {
    border: 2px solid #e6ad50;
    border-radius: 9px;
    background: #2a2115;
}

QWidget[validationState="error"] QLabel#validationMessage {
    color: #ff9aa5;
}

QWidget[validationState="warning"] QLabel#validationMessage {
    color: #f3c46d;
}

QWidget#fieldBlock[validationState="error"] {
    border: 1px solid #ef6472;
    border-radius: 9px;
    background: #211621;
}

QWidget#fieldBlock[validationState="warning"] {
    border: 1px solid #e6ad50;
    border-radius: 9px;
    background: #252015;
}

QComboBox::drop-down, QDateEdit::drop-down {
    border: 0;
    width: 24px;
}

QComboBox#priorityStrategy {
    padding-right: 32px;
}

QComboBox#priorityStrategy::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border: 0;
}

QComboBox#priorityStrategy::down-arrow {
    image: url(assets/chevron-down-dark.svg);
    width: 10px;
    height: 6px;
}

/* Keep the calendar navigation neutral; selection may still use the accent. */
QCalendarWidget#dateCalendar QWidget#qt_calendar_navigationbar {
    background: #171f2d;
    border: 0;
}

QCalendarWidget#dateCalendar QToolButton {
    min-height: 26px;
    background: #202938;
    border-color: #3a465a;
    color: #d8e1ed;
}

QCalendarWidget#dateCalendar QToolButton:hover {
    background: #293547;
    border-color: #536278;
}

QCalendarWidget#dateCalendar QAbstractItemView {
    background: #101827;
    alternate-background-color: #141e2f;
    selection-background-color: #45627f;
    selection-color: #ffffff;
}

QComboBox QAbstractItemView {
    background: #151e31;
    border: 1px solid #2d3a55;
    selection-background-color: #285faa;
    outline: 0;
}

QPushButton, QToolButton {
    min-height: 32px;
    background: #182238;
    border: 1px solid #2a3854;
    border-radius: 8px;
    padding: 1px 11px;
    color: #dbe5f8;
    font-weight: 600;
}

QPushButton:hover, QToolButton:hover {
    background: #202d47;
    border-color: #405374;
}

QPushButton:pressed, QToolButton:pressed {
    background: #111a2c;
}

QPushButton:disabled, QToolButton:disabled {
    color: #59657b;
    background: #11182a;
    border-color: #1e283b;
}

QPushButton#primaryButton {
    background: #347ff0;
    border-color: #4d91f5;
    color: #ffffff;
    padding-left: 18px;
    padding-right: 18px;
}

QPushButton#primaryButton:hover {
    background: #438df8;
}

QPushButton#dangerButton {
    color: #ff9ba5;
    background: #2c1925;
    border-color: #5a2c3b;
}

QToolButton#seatButton {
    min-width: 49px;
    max-width: 58px;
    min-height: 52px;
    padding: 3px;
    background: #101a2c;
    border-color: #2d3b57;
    font-size: 11px;
}

QToolButton#seatButton:checked {
    color: #ffffff;
    background: #256fc7;
    border: 2px solid #70b5ff;
}

QCheckBox {
    spacing: 8px;
    color: #c8d4e9;
}

QCheckBox::indicator {
    width: 17px;
    height: 17px;
    border: 1px solid #41506d;
    border-radius: 5px;
    background: #0d1526;
}

QCheckBox::indicator:checked {
    background: #3986f3;
    border-color: #65a3fb;
    image: url(assets/check.svg);
}

QListWidget#priorityList::indicator {
    width: 17px;
    height: 17px;
    border: 1px solid #41506d;
    border-radius: 5px;
    background: #0d1526;
}

QListWidget#priorityList::indicator:checked {
    background: #3986f3;
    border-color: #65a3fb;
    image: url(assets/check.svg);
}

QToolButton#helpButton {
    min-width: 20px;
    min-height: 20px;
    max-width: 20px;
    max-height: 20px;
    border-radius: 10px;
    padding: 0;
    color: #9fc9ff;
    background: #182a46;
    border: 1px solid #42658e;
    font-weight: 700;
}

QToolButton#berthStepButton {
    min-width: 30px;
    min-height: 30px;
    max-width: 30px;
    max-height: 30px;
    padding: 0;
    border-radius: 15px;
    font-size: 18px;
}

QCheckBox:disabled {
    color: #6e7a91;
}

QTabWidget::pane {
    border: 0;
    background: transparent;
}

QTabBar::tab {
    color: #8794ac;
    background: transparent;
    border: 0;
    border-bottom: 2px solid transparent;
    padding: 10px 18px;
    font-weight: 600;
}

QTabBar::tab:selected {
    color: #eaf2ff;
    border-bottom-color: #438cf5;
}

QTabBar::tab:hover:!selected {
    color: #b9c6dc;
}

QListWidget#priorityList, QListWidget#timeline {
    background: #0c1424;
    border: 1px solid #253149;
    border-radius: 9px;
    outline: 0;
    padding: 4px;
}

QListWidget#priorityList::item, QListWidget#timeline::item {
    min-height: 27px;
    border-radius: 6px;
    padding: 3px 7px;
}

QListWidget#priorityList::item:selected {
    background: #233b62;
}

QListWidget#timeline::item {
    border-left: 1px solid #28354e;
    margin-left: 8px;
}

QFrame#currentPhase {
    background: #0c1424;
    border: 1px solid #253149;
    border-radius: 9px;
}

QLabel#currentPhaseIcon {
    min-width: 20px;
    font-size: 18px;
    font-weight: 700;
    color: #5d7090;
}

QLabel#currentPhaseIcon[phaseState="active"] { color: #4b98f6; }
QLabel#currentPhaseIcon[phaseState="success"] { color: #57c78c; }
QLabel#currentPhaseIcon[phaseState="failed"] { color: #ef7180; }
QLabel#currentPhaseIcon[phaseState="stopped"] { color: #eca652; }
QLabel#currentPhaseTitle { color: #e6eefb; font-weight: 700; }
QLabel#currentPhaseMessage { color: #99a8c0; }

QTextEdit#logView {
    color: #cbd7eb;
    background: #080d18;
    border: 1px solid #1e2a40;
    border-radius: 9px;
    padding: 8px;
    font-family: "Cascadia Mono", "Consolas", monospace;
    font-size: 12px;
    selection-background-color: #2c68af;
}

QSplitter::handle {
    background: transparent;
    width: 6px;
    height: 6px;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #34415a;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #4a5a77;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: transparent;
    height: 0;
}

QToolTip {
    color: #f0f4fc;
    background: #1b263c;
    border: 1px solid #3b4a67;
    padding: 5px;
}
